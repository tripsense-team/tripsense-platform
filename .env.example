# Shared local Docker Compose configuration.
# Copy this file to .env at the repository root. Never commit the populated .env.

# User service
DB_USER=postgres
DB_PASS=
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

# Mail service
RESEND_API_KEY=replace-with-resend-api-key

# Place service (may alternatively remain in services/place-service/.env)
ZIOMAP_API_KEY=replace-with-ziomap-api-key
ZIOMAP_BASE_URL=https://ziomap-api.socibi.com
ZIOMAP_TIMEOUT_MS=8000

# Gateway
PLACES_RATE_LIMIT_REPLENISH_RATE=10
PLACES_RATE_LIMIT_BURST_CAPACITY=20
# Trust only the actual Next.js/reverse-proxy addresses or CIDRs. Do not use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
