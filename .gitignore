target/
*.class
*.jar
*.war
*.ear
.tools/
.m2/

# Python caches and test databases
__pycache__/
*.py[cod]
.pytest_cache/
*.db

# pnpm local content-addressable cache
/.pnpm-store/

# Runtime logs
*.log
logs/

# Local environment files
.env
.env.*
!.env.example

