# Public, browser-visible basemap token. Restrict it by origin and provider quota.
NEXT_PUBLIC_MAPVINA_API_KEY=replace-with-restricted-public-token

# Server-side Next.js rewrite target.
API_GATEWAY_URL=http://localhost:8080/api/:path*

# Optional browser API prefix. Leave empty to use same-origin /api routes.
NEXT_PUBLIC_API_GATEWAY_URL=
