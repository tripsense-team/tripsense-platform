# Public, browser-visible basemap token. Restrict it by origin and provider quota.
NEXT_PUBLIC_MAPVINA_API_KEY=replace-with-restricted-public-token

# Server-side Next.js rewrite target.
API_GATEWAY_URL=http://localhost:8080

# Optional browser API prefix. Leave empty to use same-origin /api routes.
NEXT_PUBLIC_API_GATEWAY_URL=

# AI service endpoint used by browser-side planner integrations.
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8089

# Firebase Web Push Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tripsense-642bd
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tripsense-642bd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tripsense-642bd.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=416102507883
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google OAuth 2.0 Client ID for Google Identity Services.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Frontend feature flags.
NEXT_PUBLIC_PLACE_PHOTOS_ENABLED=true
NEXT_PUBLIC_COMMUNITY_REVIEW_WRITES_ENABLED=false

# Opt-in grouped For You preview. Deploy Place and Recommendation endpoints first.
NEXT_PUBLIC_EXPLORE_SECTION_FEED_ENABLED=true
NEXT_PUBLIC_USE_SOCIAL_POST_MOCK=false
