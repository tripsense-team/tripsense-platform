# Shared local service configuration.
# Copy this file to env/.env. Never commit the populated file.

# Service Ports Configuration
DISCOVERY_SERVER_PORT=8761
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
MAIL_SERVICE_PORT=8082
PLACE_SERVICE_PORT=8083
TRIP_SERVICE_PORT=8084
SOCIAL_SERVICE_PORT=8086

# User database
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_USER=postgres
USER_DB_PASS=
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters

# Trip service
TRIP_DB_HOST=localhost
TRIP_DB_PORT=5432
TRIP_DB_NAME=tripsense_trip
TRIP_DB_USER=postgres
TRIP_DB_PASS=

# Social service
SOCIAL_DB_HOST=localhost
SOCIAL_DB_PORT=5432
SOCIAL_DB_NAME=tripsense_social
SOCIAL_DB_USER=postgres
SOCIAL_DB_PASS=

# Place service data stores
MONGODB_URI=mongodb://localhost:27017/tripsense_places
MONGODB_DATABASE=tripsense_places
MONGODB_AUTO_INDEX_CREATION=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# Service discovery and internal URLs. Override to container names in Docker.
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true
EMAIL_SERVICE_URL=http://localhost:8082
PLACE_SERVICE_URL=http://localhost:8083

# Mail service
RESEND_API_KEY=replace-with-resend-api-key

# Place service (may alternatively remain in services/place-service/.env)
ZIOMAP_API_KEY=replace-with-ziomap-api-key
ZIOMAP_BASE_URL=https://ziomap-api.socibi.com
ZIOMAP_TIMEOUT_MS=8000
DEFAULT_CITY=Da Nang
DEFAULT_COUNTRY=Vietnam
DEFAULT_LAT=16.0544
DEFAULT_LNG=108.2022
CACHE_TTL_SEARCH_SECONDS=1800
CACHE_TTL_DETAILS_SECONDS=43200
CACHE_TTL_AUTOCOMPLETE_SECONDS=3600
CACHE_TTL_PROVIDER_SECONDS=2592000
MIN_LOCAL_RESULTS=5

# Trip service cache
TRIP_CACHE_TTL=10m

# AI service (only required when the AI service is started)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-gemini

# Gateway
PLACES_RATE_LIMIT_REPLENISH_RATE=10
PLACES_RATE_LIMIT_BURST_CAPACITY=20
SOCIAL_RATE_LIMIT_ENABLED=true
SOCIAL_RATE_LIMIT_REPLENISH_RATE=30
SOCIAL_RATE_LIMIT_BURST_CAPACITY=60
# Trust only the actual Next.js/reverse-proxy addresses or CIDRs. Do not use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Cloudinary Social Post uploads — keep the secret backend-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SOCIAL_FOLDER=tripsense/social
