ZIOMAP_API_KEY=replace-with-ziomap-api-key
ZIOMAP_BASE_URL=https://ziomap-api.socibi.com
ZIOMAP_TIMEOUT_MS=2500
# Provider photo calls require explicit rights approval. Keep false until approved.
ZIOMAP_PHOTO_DISPLAY_APPROVED=false
ZIOMAP_PHOTO_MAX_WIDTH_PX=640
ZIOMAP_PHOTO_ALLOWED_HOSTS=lh3.googleusercontent.com,ziomap-api.socibi.com
# Fail closed until ZioMap/provider terms have been reviewed and recorded.
ZIOMAP_PHOTO_PERSISTENCE_APPROVED=false
ZIOMAP_PHOTO_PERSISTENCE_LICENSE_EVIDENCE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PLACE_FOLDER_PREFIX=tripsense/places
MONGODB_URI=mongodb://localhost:27017/tripsense_places
# Enable only after the target environment points to the intended shared Mongo database.
PLACE_ADMIN_CATALOG_WRITES_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
PLACE_SERVICE_PORT=8083
SERVER_PORT=8083
