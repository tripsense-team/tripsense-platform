{
  "name": "ai-service",
  "version": "1.0.0",
  "description": "TripSense AI Service powered by Hono and Vercel AI SDK",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "npm run build && node --test dist/ai/gemini-key-manager.test.js dist/ai/tools/update-trip-planning-brief.test.js",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/db/migrate.ts",
    "postinstall": "node scripts/patch-google-provider.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/openai": "^4.0.82",
    "@ai-sdk/provider": "^4.0.20",
    "@hono/node-server": "^1.13.8",
    "ai": "^7.0.123",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.4",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
